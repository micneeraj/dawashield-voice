# Copy this file to .env to set optional keys. Docker Compose reads .env only if it exists.
# DawaShield starts and runs its core check without ANY of these. Never commit a real .env.

# Public reCAPTCHA Enterprise site key for App Check on a hosted domain.
# Needed only for cloud AI and push alerts. Not needed on localhost.
# Build-time value: it is baked into the image at docker compose build.
# VITE_RECAPTCHA_SITE_KEY=

# Debug App Check token for localhost, so cloud AI can run on localhost. Optional.
# VITE_APPCHECK_DEBUG_TOKEN=

# Maintainer scripts only (npm run audio, npm run i18n, npm run audio:gemini).
# The app never reads these and they are not in the Docker image.
# SARVAM_API_KEY=
# GEMINI_API_KEY=

# Maintainer script only (npm run push, daily web push). Not needed to run the app.
# FIREBASE_SERVICE_ACCOUNT=
